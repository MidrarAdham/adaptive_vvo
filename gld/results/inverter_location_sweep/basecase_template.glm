// Run from gld/basecase: gridlabd 4_node.glm
// Residential secondary feeder: 30 houses along a shared 120/240 V main.
// Fixed upstream source feeds Node4 through a primary line with finite impedance.
module tape;
module powerflow {
    solver_method NR;
};
clock {
    timezone US/OR/Portland;
    timestamp '2025-09-01 00:00:00';
    stoptime '2025-09-01 23:59:00';
}

object node {
    name upstream_source;
    bustype SWING;
    phases AN;
    nominal_voltage 2400;
    voltage_A 2400+0j;
}

// Original four-node feeder conductor data: resistance in ohm/mile, GMR in ft.
object overhead_line_conductor {
    name OH100;
    geometric_mean_radius 0.0244;
    resistance 0.306;
}
object overhead_line_conductor {
    name OH101;
    geometric_mean_radius 0.00814;
    resistance 0.592;
}
object line_spacing {
    name LS200;
    distance_AB 2.5;
    distance_BC 4.5;
    distance_AC 7.0;
    distance_AN 5.656854;
    distance_BN 4.272002;
    distance_CN 5.0;
}
// The AN upstream line uses conductor A, neutral, and their spacing.
// B/C definitions retain the original configuration for future three-phase use.
object line_configuration {
    name LC300;
    conductor_A OH100;
    conductor_B OH100;
    conductor_C OH100;
    conductor_N OH101;
    spacing LS200;
}
object overhead_line {
    name upstream_line;
    phases AN;
    from upstream_source;
    to Node4;
    length 1000 ft;
    configuration LC300;
}
object node {
    name Node4;
    phases AN;
    nominal_voltage 2400;
}

// Study assumption: 50 kVA service transformer, existing 1% R / 6% X.
// GridLAB-D center-tapped secondary_voltage is the 120 V leg base.
object transformer_configuration {
    name PoleTop;
    connect_type SINGLE_PHASE_CENTER_TAPPED;
    install_type POLETOP;
    power_rating 50;
    powerA_rating 50;
    primary_voltage 2400;
    secondary_voltage 120;
    resistance 0.01;
    reactance 0.06;
}
object transformer {
    name split_boi;
    phases AS;
    from Node4;
    to mr_meter1;
    configuration PoleTop;
}
object triplex_meter {
    name mr_meter1;
    phases AS;
    nominal_voltage 120;
}

// Retained conductor/geometry assumptions, not a utility equipment specification.
object triplex_line_conductor {
    name Name_1_0_AA_triplex;
    resistance 0.57;
    geometric_mean_radius 0.0111;
}
object triplex_line_configuration {
    name triplex_line_config;
    conductor_1 Name_1_0_AA_triplex;
    conductor_2 Name_1_0_AA_triplex;
    conductor_N Name_1_0_AA_triplex;
    insulation_thickness 0.1;
    diameter 0.4;
}

// Shared main: 100 ft between taps; each house has a separate 30 ft service.
// Demand scenario: 1.5x original profiles, full day; originals remain in datasets/.
// Whole-house demand is a balanced 240 V equivalent at unity power factor.
// This preserves profile power without assigning the whole house to one 120 V leg.

// House 1: tap is 100 ft along the main from the transformer.
object triplex_node {
    name tap_1;
    phases AS;
    nominal_voltage 120;
}
object triplex_line {
    name main_1;
    phases AS;
    from mr_meter1;
    to tap_1;
    length 100 ft;
    configuration triplex_line_config;
}
object triplex_line {
    name service_1;
    phases AS;
    from tap_1;
    to house_1;
    length 30 ft;
    configuration triplex_line_config;
}
object triplex_load {
    name house_1;
    phases AS;
    nominal_voltage 120;
    object player {
        name house_1_profile;
        property constant_power_12;
        file "../datasets/scaled_1p5/house_profile_1.csv";
    };
}
object recorder {
    name house_1_voltage_recorder;
    parent house_1;
    property voltage_1,voltage_2;
    interval 60;
    file "../results/basecase/house_1_voltage.csv";
}

