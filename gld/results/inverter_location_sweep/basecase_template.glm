// Residential feeder head is the transformer SECONDARY.
object recorder {
    name rec;
    parent mr_meter1;
    property voltage_1,voltage_2;
    interval 60;
    file "../results/basecase/voltage_a.csv";
}
object recorder {
    name service_power_recorder;
    parent mr_meter1;
    property measured_real_power,measured_reactive_power;
    interval 60;
    file "../results/basecase/service_power.csv";
}
object recorder {
    name node4_voltage_recorder;
    parent Node4;
    property voltage_A;
    interval 60;
    file "../results/basecase/node4_voltage.csv";
}
