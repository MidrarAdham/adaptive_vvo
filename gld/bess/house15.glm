object recorder {
    name rec;
    parent mr_meter1;
    property voltage_1,voltage_2;
    interval 60;
    file "../results/house15_bess/voltage_a.csv";
}
object recorder {
    name service_power_recorder;
    parent mr_meter1;
    property measured_real_power,measured_reactive_power;
    interval 60;
    file "../results/house15_bess/service_power.csv";
}
