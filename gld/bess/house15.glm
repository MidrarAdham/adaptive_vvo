    name node4_voltage_recorder;
    parent Node4;
    property voltage_A;
    interval 60;
    file "../results/house15_bess/node4_voltage.csv";
}

// 5 kVA inverter connected at the house-15 bus, through a child meter.
object triplex_meter {
    name house15_bess_meter;
    parent house_15;
    phases AS;
    nominal_voltage 120;
}
object inverter {
    name house15_inverter;
    parent house15_bess_meter;
    phases AS;
    generator_status ONLINE;
    generator_mode SUPPLY_DRIVEN;
    inverter_type FOUR_QUADRANT;
    four_quadrant_control_mode CONSTANT_PQ;
    rated_power 5000;
    inverter_efficiency 0.96;
    P_Out 0;
    Q_Out 0;
    object player {
        property Q_Out;
        file "../results/house15_bess/q_schedule.csv";
    };
}
// Energy capacity is a study assumption; no active-power dispatch in this test.
object battery {
    name house15_battery;
    parent house15_inverter;
    use_internal_battery_model TRUE;
    battery_type LI_ION;
    generator_mode SUPPLY_DRIVEN;
    nominal_voltage 400;
    rated_power 5000;
    battery_capacity 10000;
    state_of_charge 0.5;
    round_trip_efficiency 0.90;
}
object recorder {
    parent house15_inverter;
    property P_Out,Q_Out,VA_Out;
    interval 60;
    file "../results/house15_bess/inverter.csv";
}
object recorder {
    parent house15_battery;
    property state_of_charge,battery_load;
    interval 60;
    file "../results/house15_bess/battery.csv";
}
